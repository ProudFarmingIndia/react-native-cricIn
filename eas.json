{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "distribution": "internal",

      "android": {
        "buildType": "apk"
      },

      "env": {
        "EXPO_PUBLIC_API_HOST": "https://cricin-node-backend-module.onrender.com"
      }
    },

    "production": {
      "autoIncrement": true,

      "env": {
        "EXPO_PUBLIC_API_HOST": "https://cricin-node-backend-module.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
